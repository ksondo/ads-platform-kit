# Copy to /etc/ads-demo/images.env; chmod 600. Secrets never belong in Git.
# Use full immutable sha-<40hex> tags from successfully published GitHub Actions runs.
ADS_PORTAL_IMAGE=ghcr.io/ksondo/ads-demo-portal:sha-REPLACE_WITH_APPROVED_COMMIT
ADS_DEMO_IDENTITY_IMAGE=ghcr.io/ksondo/ads-platform-kit-identity:sha-REPLACE_WITH_APPROVED_COMMIT
# Strong random hexadecimal password (safe in a postgres:// URL).
ADS_DEMO_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
ADS_PORTAL_PORT=18089
ADS_DEMO_IDENTITY_PORT=18085
