# Copy to /etc/ads-demo/identity.env; chmod 600. Never commit filled values.
ADS_ENV=demo
DEMO_MODE=1
# Must stay 0 (or absent) once ADS Demo Access is on: shared demo passwords are never shown to the public.
DEMO_SHOW_CREDENTIALS=0
# Do not use the Software Factory production issuer. Provide a separate HTTPS hostname.
IDENTITY_PUBLIC_URL=https://REPLACE-WITH-DEMO-LOGIN-HOST.example.invalid
IDENTITY_HOST=0.0.0.0
IDENTITY_PORT=8084
IDENTITY_COOKIE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# RS256 PKCS8 PEM; use a single-line literal with \n escapes, never share it in chat.
IDENTITY_SIGNING_KEY_PEM=REPLACE_WITH_RS256_PRIVATE_KEY_PEM_ESCAPED
IDENTITY_SIGNING_KEY_ID=ads-demo-1
IDENTITY_REQUIRE_EMAIL_VERIFICATION=true
IDENTITY_PASSWORD_MIN_LENGTH=10
IDENTITY_TRUSTED_PROXY_HOPS=1
IDENTITY_LEGACY_ONBOARD_ENABLED=false
# Choose unique, strong, demo-only passwords for the internal demo accounts. They are not shown on any
# public page while DEMO_SHOW_CREDENTIALS=0.
DEMO_USER_PASSWORD=REPLACE_WITH_DEMO_USER_PASSWORD
DEMO_USER2_PASSWORD=REPLACE_WITH_DIFFERENT_CHECKER_PASSWORD
DEMO_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_ADMIN_PASSWORD
# One shared password for every demo persona (config/demo-personas.json); different from the three above.
DEMO_PERSONA_PASSWORD=REPLACE_WITH_DIFFERENT_PERSONA_PASSWORD
MAIL_TRANSPORT=log
# Outgoing email (required for ADS Demo Access, registration and password reset). Uncomment and fill
# on the server; authenticated SMTP as the ADS mailbox. See docs/EMAIL_SETUP.md for SPF/DKIM/DMARC.
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Africa Digital Synergy <admin@africadigitalsynergy.com>
# MAIL_REPLY_TO=
# SMTP_HOST=mail.africadigitalsynergy.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=admin@africadigitalsynergy.com
# SMTP_PASSWORD=<mailbox password, set on the server only>

# ADS Demo Access (administrator-approved demonstrations, Commerce pilot).
# See docs/demo-access/COMMERCE_PILOT_DEPLOYMENT.md. Uncomment on the server when switching it on.
# Works only with ADS_ENV=demo and DEMO_MODE=1 (set by compose.identity.yml).
# DEMO_ACCESS_ENABLED=1
# ADS Identity accounts allowed into the central dashboard (comma-separated).
# DEMO_ACCESS_ADMIN_EMAILS=<admin1@example.com,admin2@example.com>
# Mailboxes notified of each new request (comma-separated; never shown to visitors).
# DEMO_ACCESS_NOTIFY_TO=<notify1@example.com,notify2@example.com>
# Public address of the dashboard host, used in review links inside emails.
# DEMO_ACCESS_ADMIN_URL=https://admin.demo.africadigitalsynergy.com
# Secret the Commerce server presents to check a visitor's grant: openssl rand -hex 32.
# The same value is set in Commerce as DEMO_ACCESS_CHECK_SECRET. A file path may be given instead
# with DEMO_ACCESS_CHECK_SECRET_COMMERCE_FILE.
# DEMO_ACCESS_CHECK_SECRET_COMMERCE=<64 hex characters from openssl rand -hex 32>
# Private operator-provisioned visitors (docs/demo-access/PRIVATE_OPERATOR_VISITOR.md). Private mode needs
# DEMO_ACCESS_ENABLED=0 (or absent) and DEMO_SHOW_CREDENTIALS=0; public request forms then answer 404.
# DEMO_ACCESS_PRIVATE_ENABLED=1
# One grant-check secret per product, each different (openssl rand -hex 32, at least 32 characters). The
# product server holds the same value as its DEMO_ACCESS_CHECK_SECRET. Each also accepts a _FILE variant.
# Names only; never commit or paste the values (docs/demo-access/DEMO_PUBLICATION_CONTRACT.md).
# DEMO_ACCESS_CHECK_SECRET_EDUCATION=<64 hex characters>
# DEMO_ACCESS_CHECK_SECRET_AGRICULTURE=<64 hex characters>
# DEMO_ACCESS_CHECK_SECRET_TONTINE=<64 hex characters>
# DEMO_ACCESS_CHECK_SECRET_FLEET_GUARD=<64 hex characters>
# DEMO_ACCESS_CHECK_SECRET_VENTUREWORKS=<64 hex characters>
# Time zone used for dates on the dashboard and in emails.
# DEMO_ACCESS_TIME_ZONE=Africa/Douala
# Optional; defaults shown. Grant length is capped at 30 days.
# DEMO_ACCESS_REQUEST_TTL_DAYS=30
# DEMO_ACCESS_INVITATION_TTL_DAYS=7
# DEMO_ACCESS_GRANT_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
