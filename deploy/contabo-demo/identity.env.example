# Copy to /etc/ads-demo/identity.env; chmod 600. Never commit filled values.
ADS_ENV=demo
DEMO_MODE=1
DEMO_SHOW_CREDENTIALS=1
# Do not use the Software Factory production issuer. Provide a separate HTTPS hostname.
IDENTITY_PUBLIC_URL=https://REPLACE-WITH-DEMO-LOGIN-HOST.example.invalid
IDENTITY_HOST=0.0.0.0
IDENTITY_PORT=8084
IDENTITY_COOKIE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# RS256 PKCS8 PEM; use a single-line literal with \n escapes, never share it in chat.
IDENTITY_SIGNING_KEY_PEM=REPLACE_WITH_RS256_PRIVATE_KEY_PEM_ESCAPED
IDENTITY_SIGNING_KEY_ID=ads-demo-1
IDENTITY_REQUIRE_EMAIL_VERIFICATION=true
IDENTITY_PASSWORD_MIN_LENGTH=10
IDENTITY_TRUSTED_PROXY_HOPS=1
IDENTITY_LEGACY_ONBOARD_ENABLED=false
# Choose unique, strong, demo-only passwords. Only the demo USER and the demo PERSONAS passwords may be
# shown by the hosted sign-in (DEMO_SHOW_CREDENTIALS=1); never the checker's or the admin's.
DEMO_USER_PASSWORD=REPLACE_WITH_DEMO_USER_PASSWORD
DEMO_USER2_PASSWORD=REPLACE_WITH_DIFFERENT_CHECKER_PASSWORD
DEMO_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_ADMIN_PASSWORD
# One shared password for every demo persona (config/demo-personas.json); different from the three above.
DEMO_PERSONA_PASSWORD=REPLACE_WITH_DIFFERENT_PERSONA_PASSWORD
MAIL_TRANSPORT=log
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
