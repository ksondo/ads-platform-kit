# Copy to deploy/.env and fill in. Never commit the real .env.

# Public address of the login service (must be https in production).
IDENTITY_PUBLIC_URL=https://login.africadigitalsynergy.com
IDENTITY_DB_PASSWORD=change-me-long-random

# Random secret (at least 32 characters) for signing cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_COOKIE_SECRET=

# RS256 private key that signs product tokens. Generate once and keep it safe:
#   docker compose run --rm identity node src/cli.mjs generate-key
# Paste on one line with \n for line breaks, or mount it as a Docker secret.
IDENTITY_SIGNING_KEY_PEM=
IDENTITY_SIGNING_KEY_ID=ads-1

# Number of reverse proxies in front of the service (their addresses are trusted for rate limiting).
IDENTITY_TRUSTED_PROXY_HOPS=1

# New accounts must confirm the activation email before they can sign in.
IDENTITY_REQUIRE_EMAIL_VERIFICATION=true
IDENTITY_PASSWORD_MIN_LENGTH=10

# Email (SMTP). Ask your mail host for these; see docs/EMAIL_SETUP.md for SPF/DKIM.
MAIL_TRANSPORT=smtp
MAIL_FROM=Africa Digital Synergy <admin@africadigitalsynergy.com>
MAIL_REPLY_TO=admin@africadigitalsynergy.com
SMTP_HOST=mail.africadigitalsynergy.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@africadigitalsynergy.com
SMTP_PASSWORD=

# Google sign-in (optional; leave empty to hide the button). See docs/GOOGLE_SIGN_IN_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
