FROM node:22-alpine
WORKDIR /app
COPY services/business-opportunities/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY services/business-opportunities/seed.mjs services/business-opportunities/seed-discovery.mjs services/business-opportunities/validate-seed.mjs ./
COPY services/business-opportunities/seed/ ./seed/
USER node
CMD ["node","validate-seed.mjs"]
