{
  "openapi": "3.1.0",
  "info": {
    "title": "ADS Subscriptions foundation",
    "version": "0.1.0",
    "description": "SH-1-S01 only. Test-mode foundation; no paid activation, provider payment, UI or release acceptance."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:42110"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health, without authentication",
        "responses": {
          "200": {
            "description": "API process is responding; not payment readiness"
          }
        }
      }
    },
    "/v1/subscriptions/admin/plans": {
      "post": {
        "summary": "Create product plan (ADS operator only)",
        "security": [
          {
            "adsBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid ADS token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Product role cannot subscribe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not authorised for this scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version, tariff agreement or replay conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Plan"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/subscriptions/admin/plans/{id}/tariffs": {
