    "/v1/subscriptions/entitlements/{key}": {
      "get": {
        "summary": "Evaluate own organisation active grants",
        "security": [
          {
            "adsBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tenantId",
                    "product",
                    "key",
                    "entitled",
                    "limit",
                    "sources"
                  ],
                  "properties": {
                    "tenantId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "product": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "entitled": {
                      "type": "boolean"
                    },
                    "limit": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "startsAt",
                          "endsAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "startsAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "endsAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid ADS token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Product role cannot subscribe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not authorised for this scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version, tariff agreement or replay conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adsBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ADS RS256 JWT"
      }
    },
    "schemas": {
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "key",
          "name"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "fr"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              }
            }
          }
        }
      },
      "Tariff": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion",
          "amountXaf",
          "effectiveAt",
          "durationDays",
          "renewalRule",
          "funding",
          "entitlements",
          "usageLimits",
          "eligibleTenantIds"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "amountXaf": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3660
          },
          "renewalRule": {
            "enum": [
              "NONE",
              "MANUAL"
            ]
          },
          "funding": {
            "enum": [
              "FREE",
              "PAID",
              "PROMOTIONAL",
              "SPONSORED"
            ]
          },
          "entitlements": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          },
          "usageLimits": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "eligibleTenantIds": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "planId",
          "expectedTariffId"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedTariffId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Cancel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "expectedVersion"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message",
          "testMode"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "object",
            "required": [
              "en",
              "fr"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "fr": {
                "type": "string"
              }
            }
          },
          "testMode": {
            "const": true
          }
        }
      },
      "Subscription": {
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "product",
          "tariff_id",
          "snapshot",
          "state",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "product": {
            "type": "string"
          },
          "tariff_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot": {
            "type": "object"
          },
          "state": {
            "enum": [
              "PENDING_PAYMENT",
              "ACTIVE",
              "CANCELLED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
